{
	"name": "cluvo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "bun test --recursive",
		"test:unit": "bun test packages",
		"test:e2e": "bun test test/e2e --timeout 30000",
		"test:compat": "bun run build && bun test ./test/compat/dist-exports.compat.ts --timeout 30000",
		"test:coverage": "bun test --recursive --coverage",
		"test:stress": "bun test --recursive --randomize --rerun-each 3 --timeout 30000",
		"verify": "bun run check && bun run typecheck && bun run build && bun run test && bun run test:compat",
		"build": "bun run --filter '*' build",
		"typecheck": "tsc --build --force",
		"check": "biome check",
		"format": "biome check --write",
		"release": "pubm --mode ci --phase prepare",
		"release:ci": "pubm --mode ci --phase publish",
		"changesets:add": "pubm changesets add"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/node": "^25.5.0",
		"@pubm/plugin-external-version-sync": "^0.4.10",
		"@types/bun": "^1.3.11",
		"pubm": "^0.4.10",
		"typescript": "5.2.2"
	}
}
