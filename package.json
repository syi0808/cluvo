{
	"name": "cluvo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "bun test --recursive",
		"build": "bun run --filter '*' build",
		"typecheck": "tsc --build",
		"check": "biome check",
		"format": "biome check --write",
		"release": "pubm --mode ci --phase prepare",
		"release:ci": "pubm --mode ci --phase publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@pubm/plugin-external-version-sync": "^0.4.7",
		"@types/bun": "^1.3.11",
		"pubm": "^0.4.7"
	}
}
